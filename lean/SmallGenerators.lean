import GRHMiller
import GRHMiller.Bach.Theorem

/-!
Consequences of Bach's theorem for a prime modulus, deduced from `Bach.bach_char` and
`GRHMiller.exists_dirichletCharacter_ne_one_trivial_on` as formalized in `amrehan/grh-miller`.
Written for the Assuming RH project.

* `exists_small_not_mem_subgroup`: every proper subgroup of the units modulo a prime `p` misses
  a positive integer below `2 (log p)^2`.
* `closure_small_eq_top`: the units modulo `p` are generated by the positive integers below
  `2 (log p)^2`.
* `least_kth_power_nonresidue_lt`: for `k > 1` dividing `p - 1`, some positive integer below
  `2 (log p)^2` is not a `k`-th power modulo `p`.
-/

open GRHMiller

namespace AssumingRH

theorem exists_small_not_mem_subgroup (hGRH : DirichletLZerosOnLine) (p : ℕ) [Fact p.Prime]
    (H : Subgroup (ZMod p)ˣ) (hH : H ≠ ⊤) :
    ∃ n : ℕ, 0 < n ∧ (n : ℝ) < 2 * Real.log p ^ 2 ∧
      ∃ u : (ZMod p)ˣ, (u : ZMod p) = n ∧ u ∉ H := by
  have hpne : NeZero p := ⟨(Fact.out : p.Prime).ne_zero⟩
  obtain ⟨χ, hχ1, hχH⟩ := exists_dirichletCharacter_ne_one_trivial_on p H hH
  by_contra hall
  push_neg at hall
  have key : ∀ n : ℕ, 0 < n → (n : ℝ) < min (2 * Real.log p ^ 2) (p : ℝ) → χ n = 1 := by
    intro n hn0 hn
    have hlt : n < p := by exact_mod_cast lt_of_lt_of_le hn (min_le_right _ _)
    have hne : (n : ZMod p) ≠ 0 := by
      intro h
      rw [ZMod.natCast_eq_zero_iff] at h
      exact absurd (Nat.le_of_dvd hn0 h) (not_le.mpr hlt)
    have hmem := hall n hn0 (lt_of_lt_of_le hn (min_le_left _ _)) (Units.mk0 _ hne) rfl
    have := hχH _ hmem
    simpa using this
  have hb := Bach.bach_char hGRH χ hχ1 (x := min (2 * Real.log p ^ 2) (p : ℝ)) key
  have hp_lt : (p : ℝ) < 2 * Real.log p ^ 2 := by
    rcases min_choice (2 * Real.log p ^ 2) (p : ℝ) with h | h
    · rw [h] at hb; exact absurd hb (lt_irrefl _)
    · rwa [h] at hb
  obtain ⟨g, hg⟩ : ∃ g : (ZMod p)ˣ, g ∉ H := by
    by_contra h
    push_neg at h
    exact hH (eq_top_iff.mpr fun g _ ↦ h g)
  have hval : (((g : ZMod p).val : ℕ) : ZMod p) = g := ZMod.natCast_zmod_val _
  have hvpos : 0 < (g : ZMod p).val :=
    Nat.pos_of_ne_zero (fun h => g.ne_zero ((ZMod.val_eq_zero _).mp h))
  have hvlt : (((g : ZMod p).val : ℕ) : ℝ) < 2 * Real.log p ^ 2 :=
    lt_trans (by exact_mod_cast ZMod.val_lt (g : ZMod p)) hp_lt
  exact hg (hall _ hvpos hvlt g hval.symm)

theorem closure_small_eq_top (hGRH : DirichletLZerosOnLine) (p : ℕ) [Fact p.Prime] :
    Subgroup.closure {u : (ZMod p)ˣ |
      ∃ n : ℕ, 0 < n ∧ (n : ℝ) < 2 * Real.log p ^ 2 ∧ (u : ZMod p) = n} = ⊤ := by
  by_contra hH
  obtain ⟨n, hn0, hn, u, hu, hnot⟩ := exists_small_not_mem_subgroup hGRH p _ hH
  exact hnot (Subgroup.subset_closure ⟨n, hn0, hn, hu⟩)

theorem least_kth_power_nonresidue_lt (hGRH : DirichletLZerosOnLine) (p : ℕ) [Fact p.Prime]
    (k : ℕ) (hk : 1 < k) (hkp : k ∣ p - 1) :
    ∃ n : ℕ, 0 < n ∧ (n : ℝ) < 2 * Real.log p ^ 2 ∧ ¬ ∃ y : ZMod p, y ^ k = n := by
  have hp : p.Prime := Fact.out
  have hcard : Nat.card (ZMod p)ˣ = p - 1 := by
    rw [Nat.card_eq_fintype_card, ZMod.card_units_eq_totient, Nat.totient_prime hp]
  -- the `k`-th power map on the units is not surjective
  have hH : (powMonoidHom k : (ZMod p)ˣ →* (ZMod p)ˣ).range ≠ ⊤ := by
    intro htop
    have hsurj : Function.Surjective (powMonoidHom k : (ZMod p)ˣ →* (ZMod p)ˣ) :=
      MonoidHom.range_eq_top.mp htop
    have hinj : Function.Injective (powMonoidHom k : (ZMod p)ˣ →* (ZMod p)ˣ) :=
      (Finite.injective_iff_surjective).mpr hsurj
    obtain ⟨g, hg⟩ := IsCyclic.exists_ofOrder_eq_natCard (α := (ZMod p)ˣ)
    obtain ⟨m, hm⟩ := hkp
    have hpow : (powMonoidHom k : (ZMod p)ˣ →* (ZMod p)ˣ) (g ^ m) = 1 := by
      rw [powMonoidHom_apply, ← pow_mul, mul_comm, ← hm, ← hcard, ← hg, pow_orderOf_eq_one]
    have hgm : g ^ m = 1 := hinj (by rw [hpow, map_one])
    have hdvd : orderOf g ∣ m := orderOf_dvd_of_pow_eq_one hgm
    rw [hg, hcard, hm] at hdvd
    have hm0 : 0 < m := by
      rcases Nat.eq_zero_or_pos m with h | h
      · have : 2 ≤ p := hp.two_le
        rw [h, mul_zero] at hm
        omega
      · exact h
    have := Nat.le_of_dvd hm0 hdvd
    nlinarith
  obtain ⟨n, hn0, hn, u, hu, hnot⟩ := exists_small_not_mem_subgroup hGRH p _ hH
  refine ⟨n, hn0, hn, ?_⟩
  rintro ⟨y, hy⟩
  have hy0 : y ≠ 0 := by
    rintro rfl
    rw [zero_pow (by omega)] at hy
    exact u.ne_zero (hu.trans hy.symm)
  apply hnot
  refine ⟨Units.mk0 y hy0, Units.ext ?_⟩
  rw [powMonoidHom_apply, Units.val_pow_eq_pow_val, Units.val_mk0, hy, hu]

end AssumingRH

#print axioms AssumingRH.exists_small_not_mem_subgroup
#print axioms AssumingRH.closure_small_eq_top
#print axioms AssumingRH.least_kth_power_nonresidue_lt
